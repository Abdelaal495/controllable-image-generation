# Copy this file to .env and fill in your token.  .env is gitignored; never commit a token.
#
# ImageNet-1k is a GATED Hugging Face dataset.  Before the first run you must:
#   1. accept the licence at https://huggingface.co/datasets/ILSVRC/imagenet-1k
#   2. create a token at https://huggingface.co/settings/tokens
#   3. put it below (or export HF_TOKEN=..., or add a Colab secret named HF_TOKEN)
#
# A token already present in the process environment always wins over this file, so an
# exported HF_TOKEN or a Colab secret is never overwritten by a stale .env.
#
# Not needed at all if you use  data.source: local_folder  in configs/experiments.yaml.
HF_TOKEN=
