# TEMPLATE ONLY -- this file is tracked and must stay free of any account or
# cluster-specific value.
#
# Copy to `cluster.env` (gitignored) to set your cluster defaults once.
# NEVER commit `cluster.env`: it holds YOUR allocation and one machine's settings, so
# committing it would publish an account name and break every other user on the next pull.
# Narval and Rorqual keep separate `cluster.env` files on separate filesystems, which is
# exactly why one Git repository can serve both.
# setup_cluster.sh writes this file for you; edit it only to change something.
# Every value can also be overridden per submission, e.g. `bash submit.sh --time 6:00:00`.

# Your allocation. Auto-detected from ~/projects when you have exactly one.
MPCFLOW_ACCOUNT=

# GPU request. Auto-detected from the cluster: narval -> a100:1, nibi/rorqual -> h100:1.
MPCFLOW_GPU=

MPCFLOW_TIME=03:00:00
MPCFLOW_MEM=64G
MPCFLOW_CPUS=8

# Default shard count for `bash submit.sh --array`.
MPCFLOW_SHARDS=4

MPCFLOW_CONFIG=configs/experiments.yaml

# ---------------------------------------------------------------------------------
# Typical values per cluster (set only ONE of these, in your own local cluster.env):
#
#   Narval   (A100)   MPCFLOW_GPU=a100:1
#   Rorqual  (H100)   MPCFLOW_GPU=h100:1
#   Nibi     (H100)   MPCFLOW_GPU=h100:1
#
# See docs/clusters_narval_rorqual.md.
